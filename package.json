{
  "name": "jimmy-wax-dashboard",
  "version": "0.1.0",
  "description": "Operator console and Experience Studio for Jimmy & Wax",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22"
  },
  "private": true,
  "scripts": {
    "dev": "next dev --port 3200",
    "build": "next build",
    "start": "next start --port 3200",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "contract:generate": "openapi-typescript docs/backend-contract/openapi.yaml -o src/lib/api/generated/schema.ts",
    "contract:check": "node tools/contract/check.mjs",
    "verify": "pnpm contract:check && pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "preflight": "tsx tools/preflight-production.ts --probe",
    "audit:prod": "pnpm audit --prod"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-slot": "^1.3.3",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-table": "^8.21.3",
    "lucide-react": "^0.468.0",
    "next": "16.4.3",
    "qrcode": "^1.5.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hook-form": "^7.89.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "esbuild": "0.28.2",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.4.3",
    "jsdom": "^26.1.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.0",
    "vitest": "5.0.5"
  }
}
