# Required in production. Never commit real values.
BACKEND_ORIGIN=https://api.example.com
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DASHBOARD_SESSION_SECRET=
# Leave unset in production (cookies are Secure by default). Set to false ONLY for local plain-HTTP development.
# DASHBOARD_COOKIE_SECURE=false
# Origin browsers use to reach the dashboard (scheme + host[:port]). REQUIRED behind a reverse proxy/TLS terminator or port mapping;
# without it CSRF origin checks compare against the Host header and request protocol only.
DASHBOARD_PUBLIC_ORIGIN=https://ops.example.com
# Public website origin used by Studio "Preview draft on website" (the site must support ?jw_preview=<token>). Optional.
# DASHBOARD_STOREFRONT_ORIGIN=https://www.example.com
